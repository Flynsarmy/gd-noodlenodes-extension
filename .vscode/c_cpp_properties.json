{
    "configurations": [
        {
            "name": "Mac",
            "compilerPath": "/usr/bin/clang++",
            "intelliSenseMode": "macos-clang-arm64",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/node_query_system",
                "${workspaceFolder}/src/node_query_system/search_spaces",
                "${workspaceFolder}/src/node_query_system/search_criteria",
                "${workspaceFolder}/src/node_query_system/search_spaces/point_grid",
                "${workspaceFolder}/src/behaviour_tree",
                "${workspaceFolder}/godot-cpp/include",
                "${workspaceFolder}/godot-cpp/gen/include"
            ],
            "defines": [
                "MACOS_ENABLED",
                "UNIX_ENABLED",
                "THREADS_ENABLED",
                "DEBUG_ENABLED",
                "NDEBUG",
                "GDEXTENSION"
            ]
        }
    ],
    "version": 4
}
