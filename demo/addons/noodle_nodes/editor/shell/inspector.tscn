[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/noodle_nodes/editor/shell/inspector.gd" id="1"]

[node name="Inspector" type="PanelContainer"]
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 4

[node name="Sections" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="NodeHeader" type="Label" parent="Margin/Sections"]
unique_name_in_owner = true
layout_mode = 2
text = "No node selected"
clip_text = true
text_overrun_behavior = 3

[node name="PropertiesTitle" type="Label" parent="Margin/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "PROPERTIES"

[node name="PropertiesScroll" type="ScrollContainer" parent="Margin/Sections"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PropertiesList" type="VBoxContainer" parent="Margin/Sections/PropertiesScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="PropertiesEmpty" type="Label" parent="Margin/Sections"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.63, 1)
text = "Select a node"

[node name="BlackboardTitle" type="Label" parent="Margin/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "BLACKBOARD"

[node name="BlackboardScroll" type="ScrollContainer" parent="Margin/Sections"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="BlackboardList" type="VBoxContainer" parent="Margin/Sections/BlackboardScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="BlackboardEmpty" type="Label" parent="Margin/Sections"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.58, 0.63, 1)
text = "No blackboard"

[node name="EventsTitle" type="Label" parent="Margin/Sections"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.82, 1)
theme_override_font_sizes/font_size = 11
text = "RECENT EVENTS"

[node name="EventsScroll" type="ScrollContainer" parent="Margin/Sections"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="EventsList" type="VBoxContainer" parent="Margin/Sections/EventsScroll"]
unique_name_in_owner = true
layout_mode = 2
